# GEMINI_API_KEY: Optional Gemini API key used server-side by the Kanso Smart Product Finder (/api/finder).
# If unset or set to MY_GEMINI_API_KEY, the Smart Product Finder automatically falls back to deterministic spec ranking.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the running Kanso Tech deployment.
APP_URL="http://localhost:3000"

# PORT: Port the Express + WebSocket + Vite server listens on (defaults to 3000).
PORT=3000

# SESSION_SECRET: Required secret key used to sign session cookies and auth tokens.
# Use a long random string in production.
SESSION_SECRET="replace-with-a-long-random-session-secret"

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional bootstrap credentials to provision an admin user on startup if zero admins exist.
# ADMIN_EMAIL="admin@kansotech.com"
# ADMIN_PASSWORD="change-me-strong-password"

# ADMIN_SETUP_SECRET: Optional secret required by POST /api/auth/setup-admin to claim first-time admin access when no admins exist.
# ADMIN_SETUP_SECRET="replace-with-first-admin-setup-secret"
